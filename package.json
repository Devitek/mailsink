{
  "name": "mailsink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mailsink/app dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @mailsink/app start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p . && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @mailsink/app test:e2e",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "openapi": "pnpm --filter @mailsink/openapi generate",
    "i18n:check": "lingui check sync --clean && lingui check missing --mode catalog --locale en,fr"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@lingui/format-po": "^6.12.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
