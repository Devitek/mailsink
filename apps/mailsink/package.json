{
  "name": "@mailsink/app",
  "version": "0.0.0",
  "private": true,
  "description": "Mailsink app: web UI and every HTTP surface (TanStack Start)",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
