#: apps/mailsink/src/features/workspaces/workspace-sections.tsx
msgid "{count, plural, one {# created through the Admin API (CI / E2E)} other {# created through the Admin API (CI / E2E)}}"
msgstr "{count, plural, one {# créé via l'API Admin (CI / E2E)} other {# créés via l'API Admin (CI / E2E)}}"

#: apps/mailsink/src/features/login/key-field.tsx
msgid "<0>Key rejected.</0> Check that it matches <1>MAILSINK_ADMIN_KEY</1> on the server."
msgstr "<0>Clé refusée.</0> Vérifiez qu'elle correspond à <1>MAILSINK_ADMIN_KEY</1> sur le serveur."

#: apps/mailsink/src/features/login/login-banners.tsx
msgid "<0>Too many attempts.</0> To protect this instance, sign-in is paused for <1><2>{countdown}</2><3>{total}</3></1>."
msgstr "<0>Trop de tentatives.</0> Pour protéger l'instance, les essais sont suspendus pendant <1><2>{countdown}</2><3>{total}</3></1>."

#: apps/mailsink/src/features/login/login-screen.tsx
msgid "<0>Where do I find the key?</0> It is set at deployment in the <1>MAILSINK_ADMIN_KEY</1> variable. Ask the instance operator: there are no accounts and no password reset."
msgstr "<0>Où trouver la clé ?</0> Elle est définie au déploiement dans la variable <1>MAILSINK_ADMIN_KEY</1>. Demandez-la à l'opérateur de l'instance : il n'y a ni compte ni mot de passe oublié."

#: apps/mailsink/src/features/login/key-field.tsx
msgid "Admin key"
msgstr "Clé d'administration"

