{
  "name": "@mailsink/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website (Astro Starlight), deployed to GitHub Pages",
  "type": "module",
  "scripts": {
    "sync": "tsx scripts/sync.ts",
    "dev": "pnpm sync && astro dev --port 4321",
    "build": "pnpm sync && astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "pnpm sync && astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "check:external": "tsx scripts/check-external.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.13",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.65.1",
    "starlight-links-validator": "^0.27.0",
    "starlight-openapi": "^0.27.1"
  },
  "devDependencies": {
    "@mailsink/openapi": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "satteri": "^0.11.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
